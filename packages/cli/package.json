{
  "name": "chevron-cli",
  "version": "0.0.0",
  "description": "Command line checks for Chevron rules that need the whole project (layout, cycles, baseline).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chevron": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "eslint": "10.15.0",
    "eslint-plugin-chevron": "workspace:*",
    "ts-morph": "28.0.0",
    "typescript-eslint": "8.74.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
