{
  "name": "eslint-plugin-chevron",
  "version": "0.0.0",
  "description": "ESLint plugin enforcing the Chevron architecture rules (RULES.md).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formatters/chevron-json": {
      "types": "./dist/formatters/chevron-json.d.ts",
      "default": "./dist/formatters/chevron-json.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.4.0 <6.1.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.73.0"
  }
}
