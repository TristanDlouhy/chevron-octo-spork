{
  "name": "@chevron/benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark: structural similarity of agent-written code with and without Chevron.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p reference/tsconfig.json --noEmit && tsc -p metric/tsconfig.json --noEmit",
    "test": "pnpm run test:acceptance && pnpm run test:metric",
    "test:acceptance": "vitest run --config acceptance/vitest.config.ts",
    "test:metric": "vitest run --config metric/vitest.config.ts",
    "metric": "node metric/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
